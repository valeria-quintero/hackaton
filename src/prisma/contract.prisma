// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Hackaton {
  id           Int                   @id @default(autoincrement())
  name         String
  description  String?
  startDate    TimestamptzString
  endDate      TimestamptzString
  isActive     Boolean               @default(true)
  authorId     String
  createdAt    TimestamptzString     @default(now())
  updatedAt    temporal.updatedAtString()
  participants HackatonParticipant[]
}

model HackatonParticipant {
  id         Int               @id @default(autoincrement())
  hackatonId Int
  userId     String
  createdAt  TimestamptzString @default(now())
  hackaton   Hackaton          @relation(fields: [hackatonId], references: [id], onDelete: Cascade)

  @@unique([hackatonId, userId])
  @@index([hackatonId])
  @@index([userId])
}
